#######################################################################
# Test for copying block of size 63;
#######################################################################
	.pos 0
main:	irmovq Stack, %rsp  	# Set up stack pointer

	# Set up arguments for copy function and then invoke it
	irmovq $63, %rdx		# src and dst have 63 elements
	irmovq dest, %rsi	# dst array
	irmovq src, %rdi	# src array
	call ncopy		 
	halt			# should halt with num nonzeros in %rax
StartFun:
#/* $begin ncopy-ys */
##################################################################
# ncopy.ys - Copy a src block of len words to dst.
# Return the number of positive words (>0) contained in src.
#
# Include your name and ID here.
#
# Describe how and why you modified the baseline code.
#
##################################################################
# Do not modify this portion
# Function prologue.
# %rdi = src, %rsi = dst, %rdx = len
ncopy:

##################################################################
# You can modify this portion
	# Loop header
    
	iaddq $-8, %rdx		# len <= 0?
	jl left		# if so, goto Done:

Loop:	
    mrmovq (%rdi), %r8	# read val from src...
    mrmovq 8(%rdi), %r9
    mrmovq 16(%rdi), %r10
    mrmovq 24(%rdi), %r11
    mrmovq 32(%rdi), %r12
    mrmovq 40(%rdi), %r13
    mrmovq 48(%rdi), %r14
    mrmovq 56(%rdi), %rbx


Npos0:
	rmmovq %r8, (%rsi)	# ...and store it to dst
	andq %r8, %r8		# val <= 0?
	jle Npos1		# if so, goto Npos0:
	iaddq $1, %rax		# count++

Npos1:
    rmmovq %r9, 8(%rsi)
    andq %r9, %r9
    jle Npos2
    iaddq $1, %rax

Npos2:
    rmmovq %r10, 16(%rsi)
    andq %r10, %r10
    jle Npos3
    iaddq $1, %rax

Npos3:
    rmmovq %r11, 24(%rsi)
    andq %r11, %r11
    jle Npos4
    iaddq $1, %rax

Npos4:
    rmmovq %r12, 32(%rsi)
    andq %r12, %r12
    jle Npos5
    iaddq $1, %rax

Npos5:
    rmmovq %r13, 40(%rsi)
    andq %r13, %r13
    jle Npos6
    iaddq $1, %rax

Npos6:
    rmmovq %r14, 48(%rsi)
    andq %r14, %r14
    jle Npos7
    iaddq $1, %rax

Npos7:
    rmmovq %rbx, 56(%rsi)
    andq %rbx, %rbx
    jle endpos
    iaddq $1, %rax

endpos:
    
	iaddq $64, %rdi		# src++
	iaddq $64, %rsi		# dst++

	iaddq $-8, %rdx		# len > 0?
	jge Loop			# if so, goto Loop:

left:
    iaddq $5, %rdx 
    jle l0_3

l4_7:
    iaddq $-2, %rdx
    jle l4_5

l6_7:
    iaddq $-1, %rdx
    je do6
    jmp do7

l4_5:
    je do5
    jmp do4

l0_3:
    iaddq $2, %rdx
    jle l0_1

l2_3:
    iaddq $-1, %rdx
    je do2
    jmp do3

l0_1:
    je do1
    jmp Done


do7:
    mrmovq 48(%rdi), %r8
    rmmovq %r8, 48(%rsi) 
    andq %r8, %r8
    jle do6
    iaddq $1, %rax


do6:
    mrmovq 40(%rdi), %r8
    rmmovq %r8, 40(%rsi) 
    andq %r8, %r8
    jle do5
    iaddq $1, %rax

do5:
    mrmovq 32(%rdi), %r8
    rmmovq %r8, 32(%rsi) 
    andq %r8, %r8
    jle do4
    iaddq $1, %rax


do4:
    mrmovq 24(%rdi), %r8
    rmmovq %r8, 24(%rsi) 
    andq %r8, %r8
    jle do3
    iaddq $1, %rax

do3:
    mrmovq 16(%rdi), %r8
    rmmovq %r8, 16(%rsi) 
    andq %r8, %r8
    jle do2
    iaddq $1, %rax

do2:
    mrmovq 8(%rdi), %r8
    rmmovq %r8, 8(%rsi) 
    andq %r8, %r8
    jle do1
    iaddq $1, %rax

do1:
    mrmovq (%rdi), %r8
    rmmovq %r8, (%rsi) 
    andq %r8, %r8
    jle Done
    iaddq $1, %rax


##################################################################
# Do not modify the following section of code
# Function epilogue.
Done:
	ret
##################################################################
# Keep the following label at the end of your function
End:
#/* $end ncopy-ys */
EndFun:

